From 10914725740f4fa21c6451f77451fb41a260f104 Mon Sep 17 00:00:00 2001
From: nathan-riddick <nathan-riddick@localhost>
Date: Wed, 7 Oct 2026 00:25:51 -0400
Subject: [PATCH] perf: keep the root park allocator line apart from its queues

Consumers read Service.allocator on every child free, while the emitter
exchanges Service.incoming on every pump. With the old 88-byte Service,
whether those shared a cache line depended on where the 200-byte park
was allocated. Under default mimalloc in actor_churn it happened to land
at 32 mod 64, keeping them apart (the F3 recovery of E1's loss). Under
the C-runtime allocator, or mimalloc with 64-byte alignment, it lands at
0 mod 64, and allocator, batchLimit, incoming, waiting and rootReturns
share one line.

Aligning batchLimit to 64 bytes fixes tip's favourable grouping in
place, whatever the allocation address. Line 0 holds only farm and
allocator; the queue line and the emitter-local lines are unchanged.
Six-consumer screens against daad3d9: tree +18.5% and tree-wait +15.8%
with the C-runtime allocator, tree +13.6% with mimalloc64. Under the
gate's default mimalloc, where the layout was already the good one,
tree/tree-wait cost about 1.6-1.9%. This removes placement-luck
variance; it is not a gain at the gate configuration.

The root park grows from 200 bytes (208 with asserts) to 256 and becomes
64-byte aligned. Its service_ field carries align(64) explicitly because
DMD does not propagate a member struct's alignment to the containing park. Entry, cohort and ActorSlot sizes, credits and memory
orders are unchanged.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 actors/private_actor.d     | 13 +++++++++++--
 private_actor_tests/main.d | 14 ++++++++------
 2 files changed, 19 insertions(+), 8 deletions(-)

diff --git a/actors/private_actor.d b/actors/private_actor.d
index 8ae3812..84d511d 100644
--- a/actors/private_actor.d
+++ b/actors/private_actor.d
@@ -728,8 +728,11 @@ private void waveCompleted(void* context) nothrow @nogc @system
 private struct Service
 {
     AntFarm* farm;
+    // Consumers read the allocator on every child free. Its line never holds
+    // the queues the emitter exchanges on every pump, wherever the park is
+    // allocated: sharing it cost tree/6 up to 19% with the C-runtime allocator (G3).
     ActorAllocator allocator;
-    size_t batchLimit;
+    align(64) size_t batchLimit;
     shared(Emittable*) incoming;
     Emittable* waiting;
     shared(Entry*) rootReturns;
@@ -858,6 +861,11 @@ private void freeMemory(Service* service, void* memory, size_t bytes, size_t ali
         service.allocator.deallocate(service.allocator.context, memory, bytes, alignment);
 }
 
+version (D_LP64)
+    static assert(Service.allocator.offsetof + ActorAllocator.sizeof <= 64
+        && Service.batchLimit.offsetof == 64 && Service.incoming.offsetof == 72
+        && Service.alignof == 64 && Service.sizeof == 128);
+
 private struct Batch
 {
     TableCompletionHook hook;
@@ -923,7 +931,8 @@ struct PrivateRootPark(T, alias step,
     static assert(is(typeof(&step) : PrivateRootDisposition function(
         scope ref PrivateBorrow!T, scope ref PrivateContext) nothrow @nogc @system));
 private:
-    Service service_;
+    // Explicit: DMD does not propagate Service's 64-byte alignment to the park.
+    align(64) Service service_;
     Entry* entries_;
     size_t capacity_;
     size_t live_;
diff --git a/private_actor_tests/main.d b/private_actor_tests/main.d
index 05c30d0..8939bc3 100644
--- a/private_actor_tests/main.d
+++ b/private_actor_tests/main.d
@@ -2683,12 +2683,14 @@ static assert(!__traits(compiles, PrivateContext.init.createChildren!(PItem, PNo
 static if (size_t.sizeof == 8)
 {
     static assert(PVoidCohort.sizeof == 376);
-    // The debug-only reentrancy flag (`version (assert) bool entered_`) adds a word.
-    // Service.childReturns (E2-3) accounts for one word of both.
-    // E2-4 reserves 48 more bytes in ChildBase for the resume descriptor/FIFO.
-    // F3 adds 32: Service.records/rootEntries and the outcome FIFO head/tail.
-    version (assert) static assert(PrivateRootPark!(State, repeat).sizeof == 208);
-    else static assert(PrivateRootPark!(State, repeat).sizeof == 200);
+    // Before G3 the root park was 200 bytes, plus the debug-only reentrancy
+    // word: Service.childReturns (E2-3) was one word, and F3 added 32 bytes for
+    // Service.records/rootEntries and the outcome FIFO head/tail. E2-4
+    // reserved 48 more bytes in ChildBase for the resume descriptor/FIFO.
+    // G3 aligns Service's queue line to 64 bytes, apart from the allocator:
+    // 256 bytes in both builds, 64-byte aligned.
+    static assert(PrivateRootPark!(State, repeat).sizeof == 256);
+    static assert(PrivateRootPark!(State, repeat).alignof == 64);
 }
 static assert(PUlongCohort.sizeof == PVoidCohort.sizeof + 2 * size_t.sizeof);
 static assert(PrivateChildPark!(PItem, ubyte).sizeof == PVoidCohort.sizeof + 2 * size_t.sizeof);
-- 
