+// perf-g4 inert layout control: never-executed text sized to reproduce the
+// G4 candidate's binary code-layout shift without any semantic change.
+// The probes are reachable only from the invalid-batch-limit fatal path,
+// which always aborts, so no run ever executes them. Lives only on the
+// perf-g4-inert-control branch; recorded in
+// perftest/results/perf-g4-2026-10-07/investigation/.
+
+
+ulong g4InertControl0(ulong x) nothrow @nogc @system
+{
+    immutable s = 1 * 0x9E3779B97F4A7C15UL + 0x2545F4914F6CDD1DUL;
+    x ^= x << 13; x ^= x >> 7; x ^= x << 17;
+    x += s; x ^= x << 13; x ^= x >> 7; x ^= x << 17;
+    x *= s | 1; x ^= x << 13; x ^= x >> 7; x ^= x << 17;
+    return x;
+}
