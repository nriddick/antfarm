name "ant_uv"
description "One libuv event loop on a dedicated thread beside the Ant Farm worker pool"
authors "Nathan Riddick"
license "MIT"
targetType "library"
targetPath "bin"
sourcePaths "source"
importPaths "source"
dependency "antfarm" path=".."
dependency "threadpool" path="../threadpool"
dependency "ant_fibers" path="../ant_fibers"
// The pinned libuv of scripts/build-libuv.py. Linux links its static
// archive, built here when missing. Windows links its import library uv.lib:
// the installation's lib directory on LIB, and its bin (uv.dll) on PATH at
// run time.
preGenerateCommands "python3 \"$PACKAGE_DIR/../scripts/build-libuv.py\"" platform="linux"
extraDependencyFiles "../.build/libuv/1.53.0/lib/libuv.a" platform="linux"
lflags "$PACKAGE_DIR/../.build/libuv/1.53.0/lib/libuv.a" "-ldl" platform="linux"
libs "uv" platform="windows"

toolchainRequirements {
	dmd ">=2.112.0"
	ldc ">=1.42.0"
}

configuration "library" {
	targetType "library"
}
