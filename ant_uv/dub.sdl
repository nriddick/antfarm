name "ant_uv"
description "One libuv event loop on a dedicated thread beside the Ant Farm worker pool"
authors "Nathan Riddick"
license "MIT"
targetType "library"
targetPath "bin"
sourcePaths "source"
importPaths "source"
dependency "antfarm" path=".."
dependency "threadpool" path="../threadpool"
dependency "ant_fibers" path="../ant_fibers"
// The system libuv (1.19 or later). On Windows, the import library uv.lib
// of scripts/build-libuv-windows.py's pinned build: its lib directory on LIB,
// and its bin (uv.dll) on PATH at run time.
libs "uv"

toolchainRequirements {
	dmd ">=2.112.0"
	ldc ">=1.42.0"
}

configuration "library" {
	targetType "library"
}
