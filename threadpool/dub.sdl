name "threadpool"
description "Cache-topology-aware thread pool"
authors "Nathan Riddick"
license "MIT"
targetType "library"
targetPath "bin"
sourcePaths "source"
importPaths "source"
dependency "antfarm" path=".."

toolchainRequirements {
	dmd ">=2.112.0"
	ldc ">=1.42.0"
}

configuration "library" {
	targetType "library"
}

// Default `dub test`: topology_parse.d contains unittest blocks only.
configuration "unittest" {
	targetType "executable"
	mainSourceFile "../tests/threadpool/unittest_main.d"
	sourceFiles "../tests/threadpool/topology_parse.d" "../tests/threadpool/linux_topology_parse.d" "../tests/threadpool/resolution.d" \
		"../tests/threadpool/synthetic_topology.d" "../tests/threadpool/host_plan.d"
	stringImportPaths "../tests/threadpool"
}

configuration "hello" {
	targetType "executable"
	targetName "hello-topology"
	sourceFiles "examples/hello_topology.d"
	versions "threadpool_hello"
}

configuration "wait-races" {
    targetType "executable"
    mainSourceFile "../tests/threadpool/wait_races.d"
}

configuration "affinity-test" {
    targetType "executable"
    mainSourceFile "../tests/threadpool/windows_affinity.d"
}

// Linux frozen-OS-scope regression; re-executes itself under taskset.
configuration "scope-test" {
    targetType "executable"
    mainSourceFile "../tests/threadpool/os_scope_live.d"
}

// Windows/Linux caller confine/restore and stopRequested:
// `dub run -c confine-test`, also under `taskset -c 0-3` on Linux.
configuration "confine-test" {
    targetType "executable"
    mainSourceFile "../tests/threadpool/confine_live.d"
}

// Live FarmHost regression: `dub run -c host-test`. Needs two accepted
// worker CPUs in one LLC (one per core by default), or three for a free
// caller CPU. Prints SKIP and exits 0 otherwise; check.sh treats that SKIP
// as a failure unless ALLOW_HOST_SKIP=1.
configuration "host-test" {
    targetType "executable"
    mainSourceFile "../tests/threadpool/host_live.d"
    versions "FarmHostTestHooks"
}

// wake() racing a worker-failure shutdown: `dub run -c wakefail`.
configuration "wakefail" {
    targetType "executable"
    mainSourceFile "../tests/threadpool/wakefail.d"
}

// Live hardware binary: `dub run -c live-test` (not `dub test`).
configuration "live-test" {
	targetType "executable"
	versions "threadpool_live_sisyphus"
	sourceFiles "../tests/threadpool/live_sisyphus.d"
}

platform "windows" {
	libs "kernel32"
}
