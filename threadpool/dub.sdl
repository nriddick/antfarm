name "threadpool"
description "Cache-topology-aware thread pool"
authors "Nathan Riddick"
license "BSL-1.0"
targetType "library"
targetPath "bin"
sourcePaths "source"
importPaths "source"
dependency "antfarm" path=".."

toolchainRequirements {
	dmd ">=2.112.0"
	ldc ">=1.42.0"
}

configuration "library" {
	targetType "library"
}

// Default `dub test`: topology_parse.d contains unittest blocks only.
configuration "unittest" {
	targetType "executable"
	mainSourceFile "tests/unittest_main.d"
	sourceFiles "tests/topology_parse.d" "tests/linux_topology_parse.d" "tests/resolution.d"
	stringImportPaths "tests"
}

configuration "hello" {
	targetType "executable"
	targetName "hello-topology"
	sourceFiles "examples/hello_topology.d"
	versions "threadpool_hello"
}

configuration "wait-races" {
    targetType "executable"
    mainSourceFile "tests/wait_races.d"
}

configuration "affinity-test" {
    targetType "executable"
    mainSourceFile "tests/windows_affinity.d"
}

// Linux frozen-OS-scope regression; re-executes itself under taskset.
configuration "scope-test" {
    targetType "executable"
    mainSourceFile "tests/os_scope_live.d"
}

// Linux caller confine/restore and stopRequested: `dub run -c confine-test`,
// also under `taskset -c 0-3`.
configuration "confine-test" {
    targetType "executable"
    mainSourceFile "tests/confine_live.d"
}

// Live hardware binary: `dub run -c live-test` (not `dub test`).
configuration "live-test" {
	targetType "executable"
	versions "threadpool_live_sisyphus"
	sourceFiles "tests/live_sisyphus.d"
}

platform "windows" {
	libs "kernel32"
}
