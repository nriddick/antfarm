name "antfarm"
description "Ant Farm M:N jobs, cache-aware threadpool, and colocated Fiber scheduler"
authors "Nathan Riddick"
license "BSL-1.0"
targetType "library"
importPaths "."
sourceFiles "antfarm.d" "antfarm_allocation.d" "antfarm_templates.d" \
    "actors/package.d" "actors/actor.d" \
    "actors/wave.d" "actors/private_actor.d" "actors/mimalloc.d"

toolchainRequirements {
	dmd ">=2.112.0"
	ldc ">=1.42.0"
}

subPackage "threadpool"
subPackage "fibers"

configuration "library" {
	targetType "library"
}

configuration "all-write-check" {
	// Compatibility alias: fresh-segment protection checks are unconditional.
	targetType "library"
}

configuration "unittest" {
	targetType "executable"
	mainSourceFile "antfarm_test.d"
}

configuration "mimalloc-v3" {
	targetType "library"
	versions "AntfarmMimallocV3"
	// Build before Dub checks whether a dependent target needs relinking.
	preGenerateCommands "make -C \"$PACKAGE_DIR/actor_torture\" .build/mimalloc-v3.5.3/libmimalloc.a" platform="linux"
	extraDependencyFiles "actor_torture/.build/mimalloc-v3.5.3/libmimalloc.a" platform="linux"
	lflags "$PACKAGE_DIR/actor_torture/.build/mimalloc-v3.5.3/libmimalloc.a" "-lpthread" "-lrt" "-latomic" platform="linux"
	preGenerateCommands "cmake -S \"$PACKAGE_DIR/third_party/mimalloc\" -B \"$PACKAGE_DIR/actor_torture/.build/mimalloc-v3.5.3-windows\" -DCMAKE_BUILD_TYPE=Release -DMI_OVERRIDE=OFF -DMI_BUILD_SHARED=OFF -DMI_BUILD_STATIC=ON -DMI_BUILD_OBJECT=OFF -DMI_BUILD_TESTS=OFF -DMI_OPT_ARCH=OFF -DCMAKE_ARCHIVE_OUTPUT_DIRECTORY=\"$PACKAGE_DIR/actor_torture/.build/mimalloc-v3.5.3-windows/lib\" -DCMAKE_ARCHIVE_OUTPUT_DIRECTORY_RELEASE=\"$PACKAGE_DIR/actor_torture/.build/mimalloc-v3.5.3-windows/lib\"" platform="windows-x86_64"
	preGenerateCommands "cmake --build \"$PACKAGE_DIR/actor_torture/.build/mimalloc-v3.5.3-windows\" --config Release --target mimalloc-static --parallel" platform="windows-x86_64"
	extraDependencyFiles "actor_torture/.build/mimalloc-v3.5.3-windows/lib/mimalloc.lib" platform="windows-x86_64"
	lflags "$PACKAGE_DIR/actor_torture/.build/mimalloc-v3.5.3-windows/lib/mimalloc.lib" platform="windows-x86_64"
}
