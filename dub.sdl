name "antfarm"
description "Ant Farm M:N jobs, cache-aware threadpool, and colocated Fiber scheduler"
authors "Nathan Riddick"
license "MIT"
targetType "library"
// Build outputs go under bin/: an executable named antfarm would collide
// with the antfarm/ source directory.
targetPath "bin"
importPaths "."
sourcePaths "antfarm"

toolchainRequirements {
	dmd ">=2.112.0"
	ldc ">=1.42.0"
}

subPackage "threadpool"
subPackage "ant_fibers"
subPackage "forkjoin"
subPackage "ant_uv"

configuration "library" {
	targetType "library"
}

configuration "all-write-check" {
	// Compatibility alias: fresh-segment protection checks are unconditional.
	targetType "library"
}

configuration "unittest" {
	targetType "executable"
	mainSourceFile "tests/farm/antfarm_test.d"
}

configuration "mimalloc-v3" {
	targetType "library"
	versions "AntfarmMimallocV3"
	// Build before Dub checks whether a dependent target needs relinking.
	preGenerateCommands "make -C \"$PACKAGE_DIR/tests/actors\" .build/mimalloc-v3.7.0/libmimalloc.a" platform="linux"
	extraDependencyFiles "tests/actors/.build/mimalloc-v3.7.0/libmimalloc.a" platform="linux"
	lflags "$PACKAGE_DIR/tests/actors/.build/mimalloc-v3.7.0/libmimalloc.a" "-lpthread" "-lrt" "-latomic" platform="linux"
	preGenerateCommands "cmake -S \"$PACKAGE_DIR/third_party/mimalloc\" -B \"$PACKAGE_DIR/tests/actors/.build/mimalloc-v3.7.0-windows\" -DCMAKE_BUILD_TYPE=Release -DCMAKE_MSVC_RUNTIME_LIBRARY=MultiThreaded -DMI_OVERRIDE=OFF -DMI_BUILD_SHARED=OFF -DMI_BUILD_STATIC=ON -DMI_BUILD_OBJECT=OFF -DMI_BUILD_TESTS=OFF -DMI_OPT_ARCH=OFF -DCMAKE_ARCHIVE_OUTPUT_DIRECTORY=\"$PACKAGE_DIR/tests/actors/.build/mimalloc-v3.7.0-windows/lib\" -DCMAKE_ARCHIVE_OUTPUT_DIRECTORY_RELEASE=\"$PACKAGE_DIR/tests/actors/.build/mimalloc-v3.7.0-windows/lib\"" platform="windows-x86_64"
	preGenerateCommands "cmake --build \"$PACKAGE_DIR/tests/actors/.build/mimalloc-v3.7.0-windows\" --config Release --target mimalloc-static --parallel" platform="windows-x86_64"
	extraDependencyFiles "tests/actors/.build/mimalloc-v3.7.0-windows/lib/mimalloc.lib" platform="windows-x86_64"
	lflags "$PACKAGE_DIR/tests/actors/.build/mimalloc-v3.7.0-windows/lib/mimalloc.lib" platform="windows-x86_64"
}

// mimalloc-v3 plus the secure instance for network memory
// (antfarm.secure_allocation): the pinned source built again with
// MI_SECURE=CHECKED and its symbols renamed afsec_ by
// scripts/build-mimalloc-secure.py, which needs Python 3. ant_uv routes its
// receive windows, outboxes, socket handles and libuv's allocations there.
// On Windows both archives use the static CRT that LDC and DMD link by
// default, and CMake and Python must be on PATH.
configuration "mimalloc-v3-secure" {
	targetType "library"
	versions "AntfarmMimallocV3" "AntfarmMimallocSecure"
	preGenerateCommands "make -C \"$PACKAGE_DIR/tests/actors\" .build/mimalloc-v3.7.0/libmimalloc.a .build/mimalloc-v3.7.0-secure/libmimalloc-secure.a" platform="linux"
	extraDependencyFiles "tests/actors/.build/mimalloc-v3.7.0/libmimalloc.a" "tests/actors/.build/mimalloc-v3.7.0-secure/libmimalloc-secure.a" platform="linux"
	lflags "$PACKAGE_DIR/tests/actors/.build/mimalloc-v3.7.0/libmimalloc.a" "$PACKAGE_DIR/tests/actors/.build/mimalloc-v3.7.0-secure/libmimalloc-secure.a" "-lpthread" "-lrt" "-latomic" platform="linux"
	preGenerateCommands "cmake -S \"$PACKAGE_DIR/third_party/mimalloc\" -B \"$PACKAGE_DIR/tests/actors/.build/mimalloc-v3.7.0-windows\" -DCMAKE_BUILD_TYPE=Release -DCMAKE_MSVC_RUNTIME_LIBRARY=MultiThreaded -DMI_OVERRIDE=OFF -DMI_BUILD_SHARED=OFF -DMI_BUILD_STATIC=ON -DMI_BUILD_OBJECT=OFF -DMI_BUILD_TESTS=OFF -DMI_OPT_ARCH=OFF -DCMAKE_ARCHIVE_OUTPUT_DIRECTORY=\"$PACKAGE_DIR/tests/actors/.build/mimalloc-v3.7.0-windows/lib\" -DCMAKE_ARCHIVE_OUTPUT_DIRECTORY_RELEASE=\"$PACKAGE_DIR/tests/actors/.build/mimalloc-v3.7.0-windows/lib\"" platform="windows-x86_64"
	preGenerateCommands "cmake --build \"$PACKAGE_DIR/tests/actors/.build/mimalloc-v3.7.0-windows\" --config Release --target mimalloc-static --parallel" platform="windows-x86_64"
	preGenerateCommands "python \"$PACKAGE_DIR/scripts/build-mimalloc-secure.py\" --build-dir \"$PACKAGE_DIR/tests/actors/.build/mimalloc-v3.7.0-secure-windows\" --fast-archive \"$PACKAGE_DIR/tests/actors/.build/mimalloc-v3.7.0-windows/lib/mimalloc.lib\" --cmake-arg=-DCMAKE_MSVC_RUNTIME_LIBRARY=MultiThreaded" platform="windows-x86_64"
	extraDependencyFiles "tests/actors/.build/mimalloc-v3.7.0-windows/lib/mimalloc.lib" "tests/actors/.build/mimalloc-v3.7.0-secure-windows/mimalloc-secure.lib" platform="windows-x86_64"
	lflags "$PACKAGE_DIR/tests/actors/.build/mimalloc-v3.7.0-windows/lib/mimalloc.lib" "$PACKAGE_DIR/tests/actors/.build/mimalloc-v3.7.0-secure-windows/mimalloc-secure.lib" platform="windows-x86_64"
}
