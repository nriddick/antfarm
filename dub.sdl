name "antfarm"
description "Ant Farm M:N jobs, cache-aware threadpool, and colocated Fiber scheduler"
authors "Nathan Riddick"
license "BSL-1.0"
targetType "library"
importPaths "."
sourceFiles "antfarm.d" "antfarm_allocation.d" "antfarm_templates.d" \
    "antfarm_actors/package.d" "antfarm_actors/actor.d" \
    "antfarm_actors/wave.d" "antfarm_actors/mimalloc.d"

toolchainRequirements {
	dmd ">=2.112.0"
	ldc ">=1.42.0"
}

subPackage "threadpool"
subPackage "fibers"

configuration "library" {
	targetType "library"
}

configuration "unittest" {
	targetType "executable"
	mainSourceFile "antfarm_test.d"
}

configuration "mimalloc-v3" {
	targetType "library"
	versions "AntfarmMimallocV3"
	libs "mimalloc"
}
