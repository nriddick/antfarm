name "forkjoin"
description "Fork-join dispatcher: per-worker work-stealing deques over the Ant Farm threadpool, the Farm as admission and overflow channel"
authors "Nathan Riddick"
license "MIT"
targetType "library"
targetPath "bin"
sourcePaths "source"
importPaths "source"
dependency "antfarm" path=".."
dependency "threadpool" path="../threadpool"

toolchainRequirements {
	dmd ">=2.112.0"
	ldc ">=1.42.0"
}

configuration "library" {
	targetType "library"
}

// `dub test :forkjoin`: the deque exactly-once test and the dispatcher
// admission test (parking, foreign submission, shutdown with parked workers).
configuration "unittest" {
	targetType "executable"
	buildRequirements "requireContracts"
	mainSourceFile "../tests/forkjoin/forkjoin_test.d"
	sourceFiles "../tests/forkjoin/deque_test.d" "../tests/forkjoin/admission_test.d"
	importPaths "../tests/forkjoin"
}

configuration "fib" {
	targetType "executable"
	targetName "forkjoin-fib"
	mainSourceFile "examples/forkjoin_fib.d"
}
