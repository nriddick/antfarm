name "antfarm-fibers"
description "Freely migrating druntime Fiber scheduler backed by Ant Farm"
authors "Nathan Riddick"
license "BSL-1.0"
targetType "library"
sourcePaths "source"
importPaths "source"
dependency "antfarm" path=".."
dependency "threadpool" path="../threadpool"

configuration "library" {
    targetType "library"
}

configuration "unittest" {
    targetType "executable"
    // Correctness suites: keep assert checks in release builds too.
    buildRequirements "requireContracts"
    // Compile this package's module unittests (e.g. the remote-service
    // fixtures) under any build type, so `dub run -c unittest` runs them.
    buildOptions "unittests"
    mainSourceFile "tests/smoke.d"
    sourceFiles "tests/service_plan.d" "tests/host_attach.d" "tests/semaphore.d"
    importPaths "tests"
}

configuration "stress" {
    targetType "executable"
    // Correctness suites: keep assert checks in release builds too.
    buildRequirements "requireContracts"
    mainSourceFile "tests/stress.d"
    sourceFiles "tests/service_plan.d"
    importPaths "tests"
}

configuration "hello" {
    targetType "executable"
    mainSourceFile "examples/hello_fibers.d"
}

configuration "benchmark" {
    targetType "executable"
    mainSourceFile "benchmarks/benchmark.d"
}

configuration "benchmark_mt" {
    targetType "executable"
    mainSourceFile "benchmarks/benchmark_mt.d"
}

configuration "benchmark_vs_druntime" {
    targetType "executable"
    mainSourceFile "benchmarks/benchmark_vs_druntime.d"
}

configuration "benchmark_farm_embed" {
    targetType "executable"
    mainSourceFile "benchmarks/benchmark_farm_embed.d"
}

configuration "benchmark_actor_wave" {
    targetType "executable"
    mainSourceFile "benchmarks/actor_wave.d"
}
