+// Deterministic schedules for admission slots and validated membership.
+// Every hook runs another actor at an exact pause; no sleeps are needed.
+module subscription_admission;
+import antfarm;
+import core.atomic;
+import core.stdc.stdlib : malloc, free;
+import core.stdc.stdio : puts;
+version (AntfarmWriteAuditHooks) {} else static assert(false);
+
+__gshared ConsumerView[128] views;
+__gshared ConsumerView nested;
+__gshared Token producer;
+__gshared uint probes;
+__gshared bool twoFailures, fired;
+__gshared WriteAuditPhase pauseAt;
+
+void require(bool ok, string message) nothrow @nogc @system
+{
+    if (!ok) fatal(message);
+}
+extern(C) void callback(const(ulong)*, size_t) nothrow @nogc @system {}
+struct PreparedRange
+{
+    PayloadEntry[] entries;
+    bool permit;
+    @property bool empty() const nothrow @nogc { return entries.length == 0; }
+    @property PayloadEntry front() nothrow @nogc { return entries[0]; }
+    void popFront() nothrow @nogc { entries = entries[1 .. $]; }
+    @property PreparedRange save() nothrow @nogc { return this; }
+    bool prepareTableFrontN(size_t) nothrow @nogc { return permit; }
+}
+ulong writeWords(AntFarm* f, ulong words, bool permit = true) nothrow @nogc @system
+{
+    immutable cf = atomicLoad(f.Cf);
+    immutable overhead = 29 + 8UL * sqcsOf(cf > 0 ? cast(ulong) cf : 1);
+    immutable n = cast(size_t)(words - overhead);
+    auto body = cast(ulong*) malloc(n * ulong.sizeof);
+    require(body !is null, "admission test allocation");
+    scope(exit) free(body);
+    body[0 .. n] = 0;
+    PayloadEntry[1] entries = [PayloadEntry(&callback, body[0 .. n])];
+    return f.write(PreparedRange(entries[], permit), producer);
+}
+AntFarm* createFarm() nothrow @nogc @system
+{
+    auto f = AntFarm.create(1, 4, 1, 1, 3 * (1 << 15), 0, 0, 64);
+    producer = f.registerProducer(Tier.bulk);
+    require(producer.valid, "admission producer registration");
+    return f;
+}
+void checkEmpty(AntFarm* f) nothrow @nogc @system
+{
+    require(atomicLoad(f.Cf) == 0, "membership empty");
+    require(atomicLoad(f.consumerSlots) == 0, "admission slots balanced");
+    uint pulses;
+    foreach (i; 0 .. f.K)
+    {
+        immutable rt = atomicLoad(f.Rt[i][0]);
+        require((rt >> 32) == 0, "no temporary pins remain");
+        require((rt & COUNTMASK) == 0, "no live roots remain");
+        pulses += cast(uint)((rt & LOWMASK) / SUB0);
+    }
+    require(pulses == 1, "one pulse on drained empty farm");
+}
+
+void staleProbe(AntFarm* f, WriteAuditPhase phase, ulong, ulong)
+    nothrow @nogc @system
+{
+    if (phase == WriteAuditPhase.subscriberProbed)
+    {
+        if (probes++ == 0 && twoFailures)
+        {
+            require(nested.subscribeOnce(f) == SUBSCRIBE_RETRY, "inner stale probe retries");
+            return;
+        }
+        require(writeWords(f, f.segCap) == 1, "publish epoch zero");
+        while (views[0].consumeNext()) {}
+        require(views[0].oldestEi == 1, "consumer migrated to one");
+        require(atomicLoad(f.Rt[0][0]) == 0, "old slot reclaimed");
+        require(writeWords(f, 3 * f.segCap, false) == 0, "prepare rejects after grant");
+        require(atomicLoad(f.Wt) == f.segCap, "grant did not move tail");
+    }
+    else if (phase == WriteAuditPhase.subscriberPinned && views[0].hasRef)
+        views[0].unsubscribe();
+}
+void retainedGrant(bool two)
+{
+    auto f = createFarm();
+    scope(exit) f.destroy();
+    scope(exit) f.unregisterProducer(producer);
+    require(views[0].subscribe(f) == 0, "initial consumer");
+    probes = 0;
+    twoFailures = two;
+    writeAuditHook = &staleProbe;
+    ConsumerView s;
+    require(s.subscribeOnce(f) == SUBSCRIBE_RETRY, "stale probe retries");
+    writeAuditHook = null;
+    require(atomicLoad(f.Rt[0][0]) == 0, "failed probe did not resurrect certified slot");
+    checkEmpty(f);
+    require(writeWords(f, 3 * f.segCap) == 1, "retained grant remains spendable");
+    require(s.subscribe(f) >= 0, "later subscriber finds remaining anchor");
+    while (s.consumeNext()) {}
+    s.unsubscribe();
+    checkEmpty(f);
+    puts(two ? "PASS two failed probes preserve retained grant" : "PASS failed probe preserves retained grant");
+}
+
+// Make all views hold epoch zero, with epoch zero confirmed and Wt in one.
+AntFarm* confirmedPosition(uint count)
+{
+    auto f = createFarm();
+    require(views[0].subscribe(f) == 0, "first setup view");
+    require(writeWords(f, 11000) == 1, "setup first table");
+    require(writeWords(f, 11000) == 1, "setup second table");
+    require(writeWords(f, f.segCap - 300 - 22000) == 1, "setup near boundary");
+    while (views[0].consumeNext()) {}
+    foreach (i; 1 .. count) require(views[i].subscribe(f) == 0, "setup views");
+    require(writeWords(f, 1000) == 1, "setup crossing table");
+    foreach (_; 0 .. 4) require(views[1].consumeNext(), "setup view traverses tables");
+    require(!views[1].consumeNext(), "idle rewalk confirms zero");
+    require(views[1].newestEi == 0, "confirmed position stays at zero");
+    return f;
+}
+void rejectWhileLeaving(AntFarm* f, WriteAuditPhase phase, ulong, ulong)
+    nothrow @nogc @system
+{
+    if (phase != WriteAuditPhase.subscriberFull || fired) return;
+    fired = true;
+    require(atomicLoad(f.Cf) == 128, "rejected subscriber was not counted");
+    foreach (ref v; views) v.unsubscribe();
+    checkEmpty(f);
+}
+void fullWithDepartures()
+{
+    auto f = confirmedPosition(128);
+    scope(exit) f.destroy();
+    scope(exit) f.unregisterProducer(producer);
+    fired = false;
+    writeAuditHook = &rejectWhileLeaving;
+    ConsumerView s;
+    require(s.subscribeOnce(f) == SUBSCRIBE_FULL, "capacity rejection");
+    writeAuditHook = null;
+    require(fired, "full hook reached");
+    checkEmpty(f);
+    require(s.subscribe(f) >= 0, "capacity usable after rejection");
+    s.unsubscribe();
+    checkEmpty(f);
+    puts("PASS full rejection overlapping all 128 departures");
+}
+void leaveAtHandoff(AntFarm* f, WriteAuditPhase phase, ulong, ulong)
+    nothrow @nogc @system
+{
+    if (phase != pauseAt || fired) return;
+    fired = true;
+    views[1].unsubscribe();
+    if (phase == WriteAuditPhase.subscriberCommitted)
+    {
+        require(atomicLoad(f.Cf) == 1, "committed subscriber remains counted");
+        immutable rt = atomicLoad(f.Rt[0][0]);
+        require((rt & LOWMASK) == 0 && (rt >> 32) != 0, "validated Sub carries protection");
+    }
+    else
+    {
+        require(atomicLoad(f.Cf) == 0, "uncommitted probe is not membership");
+        require((atomicLoad(f.Rt[0][0]) & LOWMASK) == SUB0, "last consumer left its pulse");
+    }
+    // A fresh grant from epoch one would need to certify slot zero.
+    require(writeWords(f, 3 * f.segCap) == 0, "protected grant refused");
+}
+void handoff(WriteAuditPhase phase)
+{
+    auto f = confirmedPosition(4);
+    scope(exit) f.destroy();
+    scope(exit) f.unregisterProducer(producer);
+    views[0].unsubscribe();
+    views[2].unsubscribe();
+    views[3].unsubscribe();
+    pauseAt = phase;
+    fired = false;
+    writeAuditHook = &leaveAtHandoff;
+    ConsumerView s;
+    require(s.subscribeOnce(f) == 0, "handoff attaches to protected epoch");
+    writeAuditHook = null;
+    require(fired, "handoff hook reached");
+    require(atomicLoad(f.Cf) == 1 && atomicLoad(f.consumerSlots) == 1, "one admitted member");
+    require((atomicLoad(f.Rt[0][0]) & LOWMASK) == 1, "real root replaces pin or pulse");
+    s.unsubscribe();
+    checkEmpty(f);
+    puts("PASS departure at subscription handoff");
+}
+void nestedProbe(AntFarm* f, WriteAuditPhase phase, ulong, ulong)
+    nothrow @nogc @system
+{
+    if (phase != WriteAuditPhase.subscriberPinned) return;
+    if (probes < 128)
+    {
+        immutable i = probes++;
+        require(views[i].subscribeOnce(f) == 0, "nested admitted probe succeeds");
+    }
+    else
+    {
+        require(atomicLoad(f.Cf) == 0, "128 probes are not members");
+        require(atomicLoad(f.consumerSlots) == 128, "128 probes reserve capacity");
+        require((atomicLoad(f.Rt[0][0]) >> 32) == 128, "Sub count bounded by admission");
+        require(nested.subscribeOnce(f) == SUBSCRIBE_FULL, "129th probe rejected before pinning");
+    }
+}
+void pendingCapacity()
+{
+    auto f = createFarm();
+    scope(exit) f.destroy();
+    scope(exit) f.unregisterProducer(producer);
+    probes = 1;
+    writeAuditHook = &nestedProbe;
+    require(views[0].subscribeOnce(f) == 0, "outer probe succeeds");
+    writeAuditHook = null;
+    require(atomicLoad(f.Cf) == 128 && atomicLoad(f.consumerSlots) == 128, "all admitted probes committed");
+    foreach (ref v; views) v.unsubscribe();
+    checkEmpty(f);
+    puts("PASS admission bounds 128 simultaneous probes");
+}
+void main()
+{
+    retainedGrant(false);
+    retainedGrant(true);
+    fullWithDepartures();
+    handoff(WriteAuditPhase.subscriberProbed);
+    handoff(WriteAuditPhase.subscriberValidated);
+    handoff(WriteAuditPhase.subscriberCommitted);
+    pendingCapacity();
+}
